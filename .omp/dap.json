{
  "adapters": {
    "gdb": {
      "command": "gdb",
      "args": ["-q", "-i", "dap"],
      "languages": ["rust"],
      "fileTypes": [".rs"],
      "rootMarkers": [
        "Cargo.toml",
        "rust-toolchain.toml",
        "rust-analyzer.toml",
        ".cargo",
        ".git"
      ],
      "launchDefaults": {
        "request": "launch",
        "stopOnEntry": false
      }
    }
  }
}
