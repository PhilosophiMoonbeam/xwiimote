# Udev permissions for wiimote LED brightness attributes.
# Keep the input group writable so tools such as wiiland-show can control LEDs
# without requiring root. Active-seat uaccess applies to device nodes, not
# sysfs attributes, so direct non-shell helpers are used for these attributes.
#
# This rule complements 70-wiiland-uinput.rules: the installed rule covers
# event reads and /dev/uinput writes, while this example covers LED writes.

SUBSYSTEM=="leds", ACTION=="add", DRIVERS=="wiimote", RUN{program}+="/usr/bin/chgrp input /sys%p/brightness", RUN{program}+="/usr/bin/chmod g+w /sys%p/brightness"
