# Udev permission setup for wiilandd
#
# wiilandd reads hid-wiimote /dev/input/event* nodes through libxwiimote and
# creates virtual evdev controllers through /dev/uinput. TAG+="uaccess" lets
# logind grant the active seat user access on Wayland desktops while GROUP and
# MODE keep a conventional input-group fallback for non-logind systems.

SUBSYSTEM=="input", KERNEL=="event*", DRIVERS=="wiimote", TAG+="uaccess", GROUP="input", MODE="0660"
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess", GROUP="input", MODE="0660"
